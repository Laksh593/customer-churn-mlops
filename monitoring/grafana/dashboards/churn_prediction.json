      },
      "description": "Dual-criterion decision: Flagged as Drift Detected (1) ONLY if BOTH PSI >= 0.1 AND Bonferroni-corrected p-value < 0.05. 0 indicates confirmed stability. Non-evaluable or missing features are rendered as NaN/Unevaluable, never as false stability.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "Stable (No Drift)"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DRIFT DETECTED"
                }
