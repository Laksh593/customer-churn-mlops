# Runtime Environment
ENVIRONMENT=development

# PostgreSQL Database Configuration (FastAPI Application)
# Note: Use URL-safe characters (alphanumeric, _, -, .) for POSTGRES_PASSWORD to avoid URL delimiter conflicts in DATABASE_URL
POSTGRES_DB=churn_db
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=placeholder_password
DATABASE_URL=postgresql+psycopg://churn_user:placeholder_password@127.0.0.1:5432/churn_db

# MLflow Tracking (Host API Serving)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Model Serving
MODEL_NAME=churn-predictor
MODEL_VERSION=1

# API Server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Apache Airflow Metadata Database (Dedicated Role & Database)
AIRFLOW_DB=airflow_db
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=placeholder_airflow_db_password

# Apache Airflow Web UI Admin Credentials
_AIRFLOW_WWW_USER_USERNAME=airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=placeholder_airflow_admin_password
AIRFLOW__WEBSERVER__SECRET_KEY=placeholder_airflow_secret_key
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqnzq8=

# Monitoring (Grafana Admin Credentials)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=placeholder_grafana_admin_password
