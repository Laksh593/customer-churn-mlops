# Runtime Environment
ENVIRONMENT=development

# PostgreSQL Database Configuration
# Note: Use URL-safe characters (alphanumeric, _, -, .) for POSTGRES_PASSWORD to avoid URL delimiter conflicts in DATABASE_URL
POSTGRES_DB=churn_db
POSTGRES_USER=churn_user
POSTGRES_PASSWORD=placeholder_password
DATABASE_URL=postgresql+psycopg://churn_user:placeholder_password@127.0.0.1:5432/churn_db

# MLflow Tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Model Serving
MODEL_NAME=churn-predictor
MODEL_VERSION=1

# API Server
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO